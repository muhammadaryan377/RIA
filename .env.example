DB_HOST=localhost
DB_PORT=5432
DB_NAME=northwind
DB_USER=postgres
DB_PASSWORD=12345
DB_SCHEMA=public
# GROQ_API_KEY is stored ENCRYPTED at rest using Windows DPAPI, bound to the
# current Windows user. Put a plain key here only for a non-Windows dev box.
# On Windows, set it to `enc1:<base64>` produced by:
#   python -c "import sys; sys.path.insert(0,'.'); from core.secret_box import encrypt; print(encrypt('<KEY>'))"
# The app decrypts it automatically at startup (core/config.py).
GROQ_API_KEY=

# Insight Agent PDF-RAG (text-based PDFs + tables)
# Create a PostgreSQL database with the pgvector extension enabled.
ARIA_RAG_DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/aria_rag
ARIA_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ARIA_RAG_LLM_MODEL=openai/gpt-oss-20b
ARIA_RAG_MAX_PDF_MB=50

# Enterprise semantic routing. Lower values make the router more willing to act;
# higher values cause more clarification instead of uncertain execution.
ARIA_RAG_ROUTER_MIN_CONFIDENCE=0.62
ARIA_RAG_ROUTER_TIMEOUT_SECONDS=10

# Local cross-encoder reranker (FastEmbed / ONNX). The first use downloads the
# model once and caches it locally. Set false to disable without changing code.
ARIA_RAG_RERANKER_ENABLED=true
ARIA_RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ARIA_RAG_RERANKER_TOP_K=10
